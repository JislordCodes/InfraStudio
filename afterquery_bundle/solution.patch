@@ -0,0 +1,35 @@
+/**
+ * Append-only clash history: records ClashResult snapshots over time so
+ * hotspots.ts can analyze how clashes evolve across repeated detection runs.
+ */
+//
+import { ClashResult, ClashSnapshot, ClashJournal } from '../types';
+//
+/**
+ * record() appends a snapshot and returns the journal for chaining. A
+ * caller-supplied timestamp is stored as-is; when omitted, the snapshot is
+ * stamped with the number of snapshots already recorded (0-based), so an
+ * untouched journal always timestamps its snapshots 0, 1, 2, ... regardless
+ * of any explicit timestamps used elsewhere. history() returns every
+ * snapshot in the order record() was called, never re-sorted by timestamp.
+ * since(timestamp) returns that same order, filtered to timestamp strictly
+ * greater than the one given.
+ */
+export function createClashJournal(): ClashJournal {
+  const snapshots: ClashSnapshot[] = [];
+  //
+  const journal: ClashJournal = {
+    record(result: ClashResult, timestamp?: number): ClashJournal {
+      const ts = timestamp === undefined ? snapshots.length : timestamp;
+      snapshots.push({ timestamp: ts, result });
+      return journal;
+    },
+    history(): ClashSnapshot[] {
+      return snapshots.slice();
+    },
+    since(timestamp: number): ClashSnapshot[] {
+      return snapshots.filter(snapshot => snapshot.timestamp > timestamp);
+    }
+  };
+  return journal;
+}
diff --git a/frontend/src/spatial/clashDetector.ts b/frontend/src/spatial/clashDetector.ts
