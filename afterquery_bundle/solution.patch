+/**
+ * Cross-snapshot hotspot analysis: ranks elements by how often and how
+ * severely they recur across a ClashJournal's recorded history.
+ */
+//
+import { ClashJournal, ClashSeverity, Hotspot, HotspotOptions } from '../types';
+//
+const SEVERITY_RANK: Record<ClashSeverity, number> = {
+  critical: 4,
+  high: 3,
+  medium: 2,
+  low: 1
+};
+const RANK_SEVERITY: ClashSeverity[] = ['low', 'medium', 'high', 'critical'];
+//
+/**
+ * analyzeHotspots(journal, options?) walks journal.history() in recorded
+ * order. For every elementId that appears (as elementA.id or elementB.id)
+ * in at least one clash of at least one snapshot:
+ *  - occurrences: the count of DISTINCT snapshots it appears in (a snapshot
+ *    with several clashes involving the same element still counts once).
+ *  - worstSeverity: the highest-ranked severity it was ever recorded at,
+ *    across every clash in every snapshot.
+ *  - trend: compares the element's worst severity within its FIRST
+ *    appearing snapshot against its worst severity within its LAST
+ *    appearing snapshot (chronological, i.e. history() order) --
+ *    'worsening' if the last is ranked higher, 'improving' if lower,
+ *    'stable' if equal or the element appears in only one snapshot.
+ * Results are sorted by occurrences descending, then worstSeverity rank
+ * descending, then elementId ascending. options.minOccurrences (default 1)
+ * drops elements below that occurrence count; options.limit, when given,
+ * truncates the sorted, filtered list to at most that many entries.
+ */
+export function analyzeHotspots(journal: ClashJournal, options?: HotspotOptions): Hotspot[] {
+  const minOccurrences = options?.minOccurrences ?? 1;
+  //
+  const perElement = new Map<string, { occurrences: number; worstRank: number; firstRank: number; lastRank: number }>();
+  //
+  for (const snapshot of journal.history()) {
+    const snapshotWorstRank = new Map<string, number>();
+    for (const clash of snapshot.result.clashes) {
+      const rank = SEVERITY_RANK[clash.severity];
+      for (const id of [clash.elementA.id, clash.elementB.id]) {
+        const current = snapshotWorstRank.get(id);
+        if (current === undefined || rank > current) {
+          snapshotWorstRank.set(id, rank);
+        }
+      }
+    }
+    //
+    for (const [id, rank] of snapshotWorstRank) {
+      let entry = perElement.get(id);
+      if (!entry) {
+        entry = { occurrences: 0, worstRank: rank, firstRank: rank, lastRank: rank };
+        perElement.set(id, entry);
+      }
+      entry.occurrences += 1;
+      entry.lastRank = rank;
+      if (rank > entry.worstRank) entry.worstRank = rank;
+    }
+  }
+  //
+  const hotspots: Hotspot[] = [];
+  for (const [elementId, entry] of perElement) {
+    if (entry.occurrences < minOccurrences) continue;
+    const trend: Hotspot['trend'] =
+      entry.lastRank > entry.firstRank ? 'worsening' :
+      entry.lastRank < entry.firstRank ? 'improving' : 'stable';
+    hotspots.push({
+      elementId,
+      occurrences: entry.occurrences,
+      worstSeverity: RANK_SEVERITY[entry.worstRank - 1],
+      trend
+    });
+  }
+  //
+  hotspots.sort((a, b) => {
+    if (a.occurrences !== b.occurrences) return b.occurrences - a.occurrences;
+    const rankA = SEVERITY_RANK[a.worstSeverity];
+    const rankB = SEVERITY_RANK[b.worstSeverity];
+    if (rankA !== rankB) return rankB - rankA;
+    return a.elementId < b.elementId ? -1 : a.elementId > b.elementId ? 1 : 0;
+  });
+  //
+  return options?.limit !== undefined ? hotspots.slice(0, options.limit) : hotspots;
+}
