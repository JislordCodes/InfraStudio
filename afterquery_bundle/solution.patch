+/**
+ * Spatial clash grouping and text/JSON export formatting
+ */
+//
+import { ClashRecord, ClashResult, ClashCluster } from './types';
+//
+/**
+ * Groups an array of clash records by severity, element ID, or discipline pair.
+ */
+export function groupClashes(
+  clashes: ClashRecord[],
+  groupBy: 'severity' | 'element' | 'discipline' | 'cluster'
+): Record<string, ClashRecord[]> {
+  const grouped: Record<string, ClashRecord[]> = {};
+  //
+  let clusterKeyOf: Map<string, string> | null = null;
+  if (groupBy === 'cluster') {
+    clusterKeyOf = new Map();
+    for (const cluster of findClashClusters(clashes)) {
+      const key = cluster.elementIds[0];
+      for (const id of cluster.elementIds) {
+        clusterKeyOf.set(id, key);
+      }
+    }
+  }
+  //
+  for (const clash of clashes) {
+    let keys: string[] = [];
+    //
+    if (groupBy === 'severity') {
+      keys = [clash.severity];
+    } else if (groupBy === 'element') {
+      keys = [clash.elementA.id, clash.elementB.id];
+    } else if (groupBy === 'discipline') {
+      const dA = clash.elementA.discipline;
+      const dB = clash.elementB.discipline;
+      const pairKey = [dA, dB].sort().join('-');
+      keys = [pairKey];
+    } else if (groupBy === 'cluster') {
+      const key = clusterKeyOf!.get(clash.elementA.id)!;
+      keys = [key];
+    }
+    //
+    for (const key of keys) {
+      if (!grouped[key]) {
+        grouped[key] = [];
+      }
+      if (!grouped[key].some(c => c.id === clash.id)) {
+        grouped[key].push(clash);
+      }
+    }
+  }
+  //
+  return grouped;
+}
+//
+/**
+ * Exports clash detection results as JSON or formatted summary text.
+ */
+export function exportClashReport(
+  result: ClashResult,
+  format: 'json' | 'summary_text'
+): string {
+  if (format === 'json') {
+    return JSON.stringify(result, null, 2);
+  }
+  //
+  const lines: string[] = [];
+  lines.push('========================================');
+  lines.push('   SPATIAL CLASH DETECTION REPORT');
+  lines.push('========================================');
+  lines.push(`Total Clashes: ${result.summary.total}`);
+  lines.push(`Hard Clashes: ${result.summary.hard}`);
+  lines.push(`Clearance Violations: ${result.summary.clearance}`);
+  lines.push(`Processed Elements: ${result.summary.processedElements}`);
+  lines.push('----------------------------------------');
+  //
+  if (result.clashes.length === 0) {
+    lines.push('No clashes detected across processed elements.');
+  } else {
+    for (let i = 0; i < result.clashes.length; i++) {
+      const c = result.clashes[i];
+      lines.push(
+        `${i + 1}. [${c.type.toUpperCase()}] (${c.severity.toUpperCase()}) ${c.elementA.name} <-> ${c.elementB.name}`
+      );
+      if (c.penetrationDepth !== undefined && c.penetrationDepth > 0) {
+        lines.push(`   Penetration Depth: ${c.penetrationDepth.toFixed(3)}m`);
+      } else if (c.distance > 0) {
+        lines.push(`   Separation Distance: ${c.distance.toFixed(3)}m`);
+      }
+    }
+  }
+  //
+  lines.push('========================================');
+  return lines.join('\n');
+}
+//
+/**
+ * Groups elements that are transitively linked by shared clashes (e.g. A-B
+ * and B-C merge into one three-element cluster) into connected components.
+ */
+export function findClashClusters(clashes: ClashRecord[]): ClashCluster[] {
+  const parent = new Map<string, string>();
+  //
+  const find = (id: string): string => {
+    if (!parent.has(id)) parent.set(id, id);
+    let root = id;
+    while (parent.get(root) !== root) {
+      root = parent.get(root) as string;
+    }
+    let cur = id;
+    while (parent.get(cur) !== root) {
+      const next = parent.get(cur) as string;
+      parent.set(cur, root);
+      cur = next;
+    }
+    return root;
+  };
+  //
+  const union = (a: string, b: string): void => {
+    const rootA = find(a);
+    const rootB = find(b);
+    if (rootA !== rootB) {
+      parent.set(rootA, rootB);
+    }
+  };
+  //
+  for (const clash of clashes) {
+    union(clash.elementA.id, clash.elementB.id);
+  }
+  //
+  const groups = new Map<string, Set<string>>();
+  for (const id of parent.keys()) {
+    const root = find(id);
+    if (!groups.has(root)) {
+      groups.set(root, new Set());
+    }
+    groups.get(root)!.add(id);
+  }
+  //
+  const edgeCounts = new Map<string, number>();
+  for (const clash of clashes) {
+    const root = find(clash.elementA.id);
+    edgeCounts.set(root, (edgeCounts.get(root) ?? 0) + 1);
+  }
+  //
+  const clusters: ClashCluster[] = [];
+  for (const [root, idSet] of groups) {
+    clusters.push({
+      elementIds: Array.from(idSet).sort(),
+      clashCount: edgeCounts.get(root) ?? 0
+    });
+  }
+  return clusters;
+}
+//
+const CLUSTER_SEVERITY_RANK: Record<string, number> = {
+  critical: 4,
+  high: 3,
+  medium: 2,
+  low: 1
+};
+//
+/**
+ * Builds every transitive cluster (same grouping as findClashClusters) and
+ * sorts them worst-first: highest severity present in the cluster, then
+ * more clashes, then the alphabetically-first elementId.
+ */
+export function rankClusters(clashes: ClashRecord[]): ClashCluster[] {
+  const parent = new Map<string, string>();
+  //
+  const find = (id: string): string => {
+    if (!parent.has(id)) parent.set(id, id);
+    let root = id;
+    while (parent.get(root) !== root) {
+      root = parent.get(root) as string;
+    }
+    let cur = id;
+    while (parent.get(cur) !== root) {
+      const next = parent.get(cur) as string;
+      parent.set(cur, root);
+      cur = next;
+    }
+    return root;
+  };
+  //
+  const union = (a: string, b: string): void => {
+    const rootA = find(a);
+    const rootB = find(b);
+    if (rootA !== rootB) {
+      parent.set(rootA, rootB);
+    }
+  };
+  //
+  for (const clash of clashes) {
+    union(clash.elementA.id, clash.elementB.id);
+  }
+  //
+  const groups = new Map<string, Set<string>>();
+  const edgeCounts = new Map<string, number>();
+  const worstSeverity = new Map<string, number>();
+  for (const clash of clashes) {
+    const root = find(clash.elementA.id);
+    if (!groups.has(root)) {
+      groups.set(root, new Set());
+    }
+    groups.get(root)!.add(clash.elementA.id);
+    groups.get(root)!.add(clash.elementB.id);
+    edgeCounts.set(root, (edgeCounts.get(root) ?? 0) + 1);
+    const rank = CLUSTER_SEVERITY_RANK[clash.severity];
+    if (!worstSeverity.has(root) || rank > (worstSeverity.get(root) as number)) {
+      worstSeverity.set(root, rank);
+    }
+  }
+  //
+  const entries = Array.from(groups.keys()).map(root => {
+    const elementIds = Array.from(groups.get(root) as Set<string>).sort();
+    return {
+      elementIds,
+      clashCount: edgeCounts.get(root) ?? 0,
+      severityRank: worstSeverity.get(root) as number
+    };
+  });
+  //
+  entries.sort((a, b) => {
+    if (a.severityRank !== b.severityRank) return b.severityRank - a.severityRank;
+    if (a.clashCount !== b.clashCount) return b.clashCount - a.clashCount;
+    return a.elementIds[0] < b.elementIds[0] ? -1 : a.elementIds[0] > b.elementIds[0] ? 1 : 0;
+  });
+  //
+  return entries.map(e => ({ elementIds: e.elementIds, clashCount: e.clashCount }));
+}
+//
+/**
+ * The single worst cluster from rankClusters (null when there are no clashes).
+ */
+export function worstCluster(clashes: ClashRecord[]): ClashCluster | null {
+  const ranked = rankClusters(clashes);
+  return ranked.length > 0 ? ranked[0] : null;
+}
