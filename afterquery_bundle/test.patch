+import { describe, it, expect } from 'vitest';
+import {
+  createAxisAlignedBoundingBox,
+  detectClashes,
+  findClashClusters,
+  SpatialElement
+} from '../src/spatial';
+//
+describe('Spatial Clash Clustering', () => {
+  it('Clash Clustering: groups a single clashing pair into one two-element cluster', () => {
+    const a: SpatialElement = { id: 'A', name: 'Beam A', discipline: 'structural', boundingBox: createAxisAlignedBoundingBox([0, 0, 0], [2, 2, 2]) };
+    const b: SpatialElement = { id: 'B', name: 'Beam B', discipline: 'structural', boundingBox: createAxisAlignedBoundingBox([1, 0, 0], [3, 2, 2]) };
+    const result = detectClashes([a, b]);
+    const clusters = findClashClusters(result.clashes);
+    expect(clusters.length).toBe(1);
+    expect(clusters[0].elementIds).toEqual(['A', 'B']);
+    expect(clusters[0].clashCount).toBe(1);
+  });
+//
+  it('Clash Clustering: transitively merges a three-element chain into a single cluster', () => {
+    const a: SpatialElement = { id: 'A', name: 'Duct A', discipline: 'mechanical', boundingBox: createAxisAlignedBoundingBox([0, 0, 0], [2, 2, 2]) };
+    const b: SpatialElement = { id: 'B', name: 'Duct B', discipline: 'mechanical', boundingBox: createAxisAlignedBoundingBox([1, 0, 0], [3, 2, 2]) };
+    const c: SpatialElement = { id: 'C', name: 'Duct C', discipline: 'mechanical', boundingBox: createAxisAlignedBoundingBox([2.5, 0, 0], [4.5, 2, 2]) };
+    // A overlaps B, B overlaps C, but A does not overlap C directly.
+    const result = detectClashes([a, b, c]);
+    const clusters = findClashClusters(result.clashes);
+    expect(clusters.length).toBe(1);
+    expect(clusters[0].elementIds).toEqual(['A', 'B', 'C']);
+    expect(clusters[0].clashCount).toBe(2);
+  });
+//
+  it('Clash Clustering: keeps unrelated clash pairs in separate clusters', () => {
+    const a: SpatialElement = { id: 'A', name: 'Wall A', discipline: 'structural', boundingBox: createAxisAlignedBoundingBox([0, 0, 0], [2, 2, 2]) };
+    const b: SpatialElement = { id: 'B', name: 'Wall B', discipline: 'structural', boundingBox: createAxisAlignedBoundingBox([1, 0, 0], [3, 2, 2]) };
+    const d: SpatialElement = { id: 'D', name: 'Pipe D', discipline: 'plumbing', boundingBox: createAxisAlignedBoundingBox([20, 0, 0], [22, 2, 2]) };
+    const e: SpatialElement = { id: 'E', name: 'Pipe E', discipline: 'plumbing', boundingBox: createAxisAlignedBoundingBox([21, 0, 0], [23, 2, 2]) };
+    const result = detectClashes([a, b, d, e]);
+    const clusters = findClashClusters(result.clashes).slice().sort((x, y) => x.elementIds[0].localeCompare(y.elementIds[0]));
+    expect(clusters.length).toBe(2);
+    expect(clusters[0].elementIds).toEqual(['A', 'B']);
+    expect(clusters[0].clashCount).toBe(1);
+    expect(clusters[1].elementIds).toEqual(['D', 'E']);
+    expect(clusters[1].clashCount).toBe(1);
+  });
+//
+  it('Clash Clustering: merges a mutually-overlapping triangle into one cluster with every edge counted', () => {
+    const a: SpatialElement = { id: 'A', name: 'Slab A', discipline: 'structural', boundingBox: createAxisAlignedBoundingBox([0, 0, 0], [3, 3, 3]) };
+    const b: SpatialElement = { id: 'B', name: 'Slab B', discipline: 'structural', boundingBox: createAxisAlignedBoundingBox([1, 1, 0], [4, 4, 3]) };
+    const c: SpatialElement = { id: 'C', name: 'Slab C', discipline: 'structural', boundingBox: createAxisAlignedBoundingBox([0.5, 2, 0], [3.5, 5, 3]) };
+    const result = detectClashes([a, b, c]);
+    const clusters = findClashClusters(result.clashes);
+    expect(clusters.length).toBe(1);
+    expect(clusters[0].elementIds).toEqual(['A', 'B', 'C']);
+    expect(clusters[0].clashCount).toBe(3);
+  });
+//
+  it('Clash Clustering: sorts elementIds ascending regardless of clash discovery order', () => {
+    const z: SpatialElement = { id: 'Z', name: 'Item Z', discipline: 'structural', boundingBox: createAxisAlignedBoundingBox([0, 0, 0], [2, 2, 2]) };
+    const m: SpatialElement = { id: 'M', name: 'Item M', discipline: 'structural', boundingBox: createAxisAlignedBoundingBox([1, 0, 0], [3, 2, 2]) };
+    const a2: SpatialElement = { id: 'A2', name: 'Item A2', discipline: 'structural', boundingBox: createAxisAlignedBoundingBox([1.5, 0, 0], [3.5, 2, 2]) };
+    const result = detectClashes([z, m, a2]);
+    const clusters = findClashClusters(result.clashes);
+    expect(clusters.length).toBe(1);
+    expect(clusters[0].elementIds).toEqual(['A2', 'M', 'Z']);
+  });
+//
+  it('Clash Clustering: excludes elements that never clash and handles an empty list safely', () => {
+    const iso1: SpatialElement = { id: 'i1', name: 'Solo 1', discipline: 'generic', boundingBox: createAxisAlignedBoundingBox([0, 0, 0], [1, 1, 1]) };
+    const iso2: SpatialElement = { id: 'i2', name: 'Solo 2', discipline: 'generic', boundingBox: createAxisAlignedBoundingBox([50, 0, 0], [51, 1, 1]) };
+    const result = detectClashes([iso1, iso2]);
+    expect(findClashClusters(result.clashes)).toEqual([]);
+    expect(findClashClusters([])).toEqual([]);
+  });
+});
+//
diff --git a/frontend/tests/clash-analytics.test.ts b/frontend/tests/clash-analytics.test.ts
new file mode 100644
index 0000000..e34dc43
--- /dev/null
+++ b/frontend/tests/clash-analytics.test.ts
@@ -0,0 +1,136 @@
+import { describe, it, expect } from 'vitest';
+import {
+  createAxisAlignedBoundingBox,
+  detectClashes,
+  createClashJournal,
+  analyzeHotspots,
+  SpatialElement,
+  ClashResult
+} from '../src/spatial';
+//
+function box(x0: number, x1: number): SpatialElement['boundingBox'] {
+  return createAxisAlignedBoundingBox([x0, 0, 0], [x1, 2, 2]);
+}
+function elem(id: string, x0: number, x1: number): SpatialElement {
+  return { id, name: id, discipline: 'structural', boundingBox: box(x0, x1) };
+}
+//
+describe('Spatial Clash Journal & Hotspot Analytics', () => {
+  it('Spatial Clash Journal: record is chainable and stamps sequential auto-timestamps when omitted', () => {
+    const result: ClashResult = detectClashes([elem('A', 0, 2)]);
+    const journal = createClashJournal();
+    expect(journal.record(result)).toBe(journal);
+    journal.record(result);
+    journal.record(result);
+    const history = journal.history();
+    expect(history.length).toBe(3);
+    expect(history.map(s => s.timestamp)).toEqual([0, 1, 2]);
+  });
+//
+  it('Spatial Clash Journal: an explicit timestamp is stored as-is, and history() never re-sorts by it', () => {
+    const result: ClashResult = detectClashes([elem('A', 0, 2)]);
+    const journal = createClashJournal();
+    journal.record(result, 100);
+    journal.record(result, 50);
+    const history = journal.history();
+    expect(history.map(s => s.timestamp)).toEqual([100, 50]);
+  });
+//
+  it('Spatial Clash Journal: since(timestamp) keeps only snapshots strictly after it, in recorded order', () => {
+    const result: ClashResult = detectClashes([elem('A', 0, 2)]);
+    const journal = createClashJournal();
+    journal.record(result).record(result).record(result);
+    expect(journal.since(0).map(s => s.timestamp)).toEqual([1, 2]);
+    expect(journal.since(2)).toEqual([]);
+  });
+//
+  it('Spatial Hotspot Analysis: an empty journal produces no hotspots', () => {
+    expect(analyzeHotspots(createClashJournal())).toEqual([]);
+  });
+//
+  it('Spatial Hotspot Analysis: occurrences count distinct snapshots, not clashes within a snapshot', () => {
+    // A overlaps both B and C in the SAME detectClashes call: two clash
+    // records, but A should only count as appearing in one snapshot.
+    const result = detectClashes([elem('A', 0, 4), elem('B', 3, 5), elem('C', -1, 1)]);
+    expect(result.summary.hard).toBe(2);
+    const journal = createClashJournal().record(result);
+    const a = analyzeHotspots(journal).find(h => h.elementId === 'A');
+    expect(a).toBeDefined();
+    expect(a!.occurrences).toBe(1);
+  });
+//
+  it('Spatial Hotspot Analysis: worstSeverity is the highest severity ever recorded, across every snapshot', () => {
+    const journal = createClashJournal();
+    // Snapshot 0: gap of 1 with tolerance 2 -> clearance/medium.
+    journal.record(detectClashes([elem('A', 0, 2), elem('B', 3, 5)], { tolerance: 2 }));
+    // Snapshot 1: overlapping -> hard/critical.
+    journal.record(detectClashes([elem('A', 0, 2), elem('B', 1, 3)]));
+    const a = analyzeHotspots(journal).find(h => h.elementId === 'A')!;
+    expect(a.worstSeverity).toBe('critical');
+  });
+//
+  it('Spatial Hotspot Analysis: trend is worsening when the last appearance outranks the first', () => {
+    const journal = createClashJournal();
+    journal.record(detectClashes([elem('A', 0, 2), elem('B', 3, 5)], { tolerance: 2 })); // medium
+    journal.record(detectClashes([elem('A', 0, 2), elem('B', 1, 3)])); // critical
+    const a = analyzeHotspots(journal).find(h => h.elementId === 'A')!;
+    expect(a.trend).toBe('worsening');
+  });
+//
+  it('Spatial Hotspot Analysis: trend is improving when the last appearance ranks below the first', () => {
+    const journal = createClashJournal();
+    journal.record(detectClashes([elem('A', 0, 2), elem('B', 1, 3)])); // critical
+    journal.record(detectClashes([elem('A', 0, 2), elem('B', 3, 5)], { tolerance: 2 })); // medium
+    const a = analyzeHotspots(journal).find(h => h.elementId === 'A')!;
+    expect(a.trend).toBe('improving');
+  });
+//
+  it('Spatial Hotspot Analysis: trend compares only the first and last appearance, not anything between', () => {
+    const journal = createClashJournal();
+    journal.record(detectClashes([elem('A', 0, 2), elem('B', 3, 5)], { tolerance: 2 })); // medium
+    journal.record(detectClashes([elem('A', 0, 2), elem('B', 1, 3)])); // critical (worse, but not last)
+    journal.record(detectClashes([elem('A', 0, 2), elem('B', 3, 5)], { tolerance: 2 })); // medium again
+    const a = analyzeHotspots(journal).find(h => h.elementId === 'A')!;
+    expect(a.trend).toBe('stable');
+    expect(a.worstSeverity).toBe('critical');
+  });
+//
+  it('Spatial Hotspot Analysis: a single appearance is always stable', () => {
+    const journal = createClashJournal().record(detectClashes([elem('A', 0, 2), elem('B', 1, 3)]));
+    const a = analyzeHotspots(journal).find(h => h.elementId === 'A')!;
+    expect(a.trend).toBe('stable');
+  });
+//
+  it('Spatial Hotspot Analysis: sorts by occurrences desc, then worst severity desc, then elementId asc', () => {
+    const journal = createClashJournal();
+    // Snapshot 0: A clashes with B (critical) and C clashes with D (critical).
+    journal.record(detectClashes([elem('A', 0, 2), elem('B', 1, 3), elem('C', 10, 12), elem('D', 11, 13)]));
+    // Snapshot 1: only A clashes again (now with E) -- A now has 2 occurrences, C/D still have 1.
+    journal.record(detectClashes([elem('A', 0, 2), elem('E', 1, 3)]));
+    const ranked = analyzeHotspots(journal);
+    // A has 2 occurrences (highest, sorts first); the rest have 1 and tie on
+    // severity, so they fall back to ascending elementId.
+    expect(ranked[0].elementId).toBe('A');
+    expect(ranked[0].occurrences).toBe(2);
+    expect(ranked.slice(1).map(h => h.elementId)).toEqual(['B', 'C', 'D', 'E']);
+  });
