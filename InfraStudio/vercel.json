{
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/dashboardomoSAL6/?",
      "headers": { "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-store" },
      "dest": "/dashboard.html"
    },
    { "src": "/studios", "dest": "https://infra-studio.vercel.app/studios" },
    { "src": "/studios/(.*)", "dest": "https://infra-studio.vercel.app/studios/$1" }
  ]
}
