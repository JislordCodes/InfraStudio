# ==============================================================================
# InfraStudio Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR ACTUAL CREDENTIALS.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# DashScope / Qwen API Configuration (Required for AI Agents)
QWEN_API_KEY=your_qwen_dashscope_api_key_here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Google Cloud Platform Service Account (For Gemini / Vertex AI)
# Option A: Full JSON string
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Option B: Path to your service account key file (ensure file is in .gitignore)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# Gemini API Key (Alternative to GCP Service Account)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# FastMCP / Microservices
MCP_URL=http://54.204.234.109:8000/mcp
AWS_REGION=us-east-1
EXPLABS_API_KEY=
